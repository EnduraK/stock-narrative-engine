# ─────────────────────────────────────────────────────────────────────────────
# Stock Narrative Engine — Environment Configuration
# Copy this file to .env and fill in your keys.
# Never commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────


# ── AI Provider (auto = use first available key found) ────────────────────────
AI_PROVIDER=auto          # auto | anthropic | openai | gemini | ollama
AI_MODEL=                 # leave blank to use the default model for the provider

# Get Claude key free at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Get GPT-4 key at https://platform.openai.com
OPENAI_API_KEY=

# Get Gemini key free at https://aistudio.google.com
GEMINI_API_KEY=

# Ollama local server (no key needed — just run: ollama serve)
OLLAMA_URL=http://localhost:11434/api/generate


# ── News API Keys (all have free tiers) ───────────────────────────────────────

# NewsAPI.org — 100 requests/day free → https://newsapi.org/register
NEWSAPI_KEY=

# Finnhub — 60 calls/minute free → https://finnhub.io/register
FINNHUB_KEY=

# Alpha Vantage — 25 calls/day free → https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=


# ── Sectors to analyse (comma-separated, blank = all) ─────────────────────────
# Options: technology, artificial_intelligence, financial_services, energy,
#          healthcare, consumer, real_estate, crypto, defense, commodities, macro
SECTORS=technology,artificial_intelligence,financial_services,crypto,macro


# ── News Fetching ─────────────────────────────────────────────────────────────
MAX_ARTICLES=200
MAX_PER_FEED=15
FETCH_RSS=true
FETCH_NEWSAPI=true
FETCH_FINNHUB=true
FETCH_ALPHA_VANTAGE=true


# ── Market Data ───────────────────────────────────────────────────────────────
MARKET_TOP_N=5            # Number of top-tickers per sector to pull
FETCH_MACRO=true          # Fetch SPY, QQQ, VIX etc for macro context


# ── Output ────────────────────────────────────────────────────────────────────
OUTPUT_DIR=reports
EXPORT_JSON=true
EXPORT_HTML=true
OPEN_BROWSER=false        # Auto-open HTML report in browser after each run


# ── Notifications (all optional) ──────────────────────────────────────────────

# Slack — create an incoming webhook at https://api.slack.com/apps
SLACK_WEBHOOK_URL=

# Email via SMTP (example uses Gmail; use an app password, not your real password)
EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Desktop pop-up (requires: pip install plyer)
DESKTOP_NOTIFY=false


# ── Run Settings ──────────────────────────────────────────────────────────────
MAX_OPPORTUNITIES=10
LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
